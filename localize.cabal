cabal-version:       2.2
name:                localize
version:             0.2.0.1
synopsis:            GNU Gettext-based messages localization library
description:         Translation framework based on @haskell-gettext@ and
                     @text-format-heavy@ packages.
license:             BSD-3-Clause
license-file:        LICENSE
author:              IlyaPortnov
maintainer:          portnov84@rambler.ru
copyright:           © 2013–2022
category:            Text
build-type:          Simple
extra-doc-files:     README.md

common shared
  build-depends:    base == 4.*,
  ghc-options:      -Wall
  default-language: Haskell2010

library
  import:              shared
  exposed-modules:     Text.Localize,
                       Text.Localize.IO
  other-modules:       Text.Localize.Types,
                       Text.Localize.Load,
                       Text.Localize.State,
                       Text.Localize.Locale
  build-depends:       binary >=0.7 && < 0.9,
                       containers >=0.5 && < 0.9,
                       bytestring >= 0.10 && < 0.13,
                       data-default >= 0.7 && < 0.9,
                       directory >= 1.3 && < 1.4,
                       filepath >= 1.4 && < 1.6,
                       Glob >= 0.7.14 && < 0.11,
                       haskell-gettext >= 0.1.1.0 && < 0.2,
                       mtl >= 2.2.1 && < 2.4,
                       text >= 1.2 && < 2.2,
                       text-format-heavy >= 0.1.4.0 && < 1.6,
                       time >=1.4 && < 1.17,
                       transformers >=0.3 && < 0.7,
                       setlocale >= 1.0 && < 1.1
  hs-source-dirs:      src

Source-repository head
  type: git
  location: https://github.com/portnov/localize.git
